DATABASE_PASSWORD=
# The token the browser extension sends. Any long random string, for example from: openssl rand -hex 32
API_TOKEN=
ANTHROPIC_API_KEY=
# New translations stop for the month once the model calls have cost this many dollars.
MONTHLY_CAP_USD=10
